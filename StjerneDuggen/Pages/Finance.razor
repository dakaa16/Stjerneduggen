@page "/finance"
@using StjerneDuggen.Components
@using StjerneDuggen.Services
@inject MarkdownToHtmlService MarkdownToHtmlService

<ScrollReset/>

<PageTitle>Financiering</PageTitle>

<div class="header-div">
	<h1>Financiering</h1>
</div>

<div class="content-div">
    <h3>Pris</h3>
	<p>@financeGeneral</p>

    <h3>Hvad dækker prisen? </h3>
    <p>Beløbet dækker følgende:</p>
	<ul>
        <li>Alle måltider i løbet af dagen, herunder:
            <ul class="nested">
                <li class="nested-list">Morgenmad</li>
                <li class="nested-list">Formiddagsfrugt</li>
                <li class="nested-list">Frokost besående af rugbrød med pålæg og en gang om måneden vil vi sammen lave et varmt måltid.</li>
                <li class="nested-list">Eftermiddagsmad</li>
            </ul>
        </li>
        <li>Materialer og aktiviteter: f.eks. kreative materialer, udflugter i nærområdet, bøger og legetøj og lignende.</li>
        <li>Omsorg og pædagogisk arbejde i små trygge rammer med nærvær, ro og faste rutiner.</li>
        <li>Min løn som selvstændig.</li>
        <li>Forsikring og øvrige driftsudgifter forbundet med ordningen.</li>
	</ul>
</div>



