@page "/"
@using StjerneDuggen.Components
@using StjerneDuggen.Services

<ScrollReset />

<PageTitle>Home</PageTitle>

<div class="title-screen">

	<div class="image-carusel-container">
		<ImageCarousel 
			ImageUrls="@ServerContentResolver.GetImageUrlsFromFolder("ForsideKarusel")"></ImageCarousel>
	</div>

	<div class="eye-catcher-card">
		<h2 class="eye-catcher-title">Hvad er Stjerneduggen? </h2>
		<p class="eye-catcher-subtitle">@whatIsSD</p>
	</div>

	<div class="value-container" @onclick="@(() => NavigateTo("motorik"))">
		<div class="eye-catcher-card">
			<h2 class="eye-catcher-title">Motorik og bevægelse</h2>
			<p class="eye-catcher-subtitle">Når børn bevæger sig, vågner sanserne, og nysgerrigheden følger med. Motorik er med i alt, hvad vi gør – fra at tage tøj på og gynge, til at tegne, spise og lege. I Stjerneduggen leger vi os til nye færdigheder og små sejre, hvor børnene prøver, udforsker og opdager, hvad deres krop kan. Med støtte, opmuntring og nærvær ved deres side bliver selv de små udfordringer til store glæder.
				Klik for at læse mere...
			</p>
		</div>
		<div class="eye-catcher-card" @onclick="@(() => NavigateTo("presence-and-safety"))">
			<h2 class="eye-catcher-title">Nærvær og tryghed</h2>
			<p class="eye-catcher-subtitle">Nærvær handler om mere end at være sammen – det handler om at være til stede.
				Her bliver hvert barn set og mødt med varme og tålmodighed, præcis som det er.
				I trygge rammer får børn tid og plads til at udvikle sig i deres eget tempo – med støtte fra sidelinjen, så de bevarer glæden ved selv at mestre.
				For når et barn mærker, at det bliver set, forstået og holdt af, vokser både modet og roen.
				Ægte nærvær og tryghed kan ikke måles i tid – kun mærkes.
				Klik for at læse mere...
			</p>
		</div>
		<div class="eye-catcher-card" @onclick="@(() => NavigateTo("nature-and-focus"))">
			<h2 class="eye-catcher-title">Natur og fordybelse</h2>
			<p class="eye-catcher-subtitle">I Stjerneduggen bruger vi naturen som vores legeplads – et sted, hvor kroppen, sanserne og nysgerrigheden får lov at udfolde sig frit.
				De naturlige omgivelser støtter en naturlig udvikling, og her lærer børn gennem oplevelse, bevægelse og forundring. I naturens ro finder vi plads til både leg, læring og fordybelse – i verden og i os selv.
				Klik for at læse mere...
			</p>
		</div>
	</div>
</div>


<div class="content-div">

	<h3>Seneste nyt </h3>
	<div class="value-container">
		<div>
			<p>
				Da Stjerneduggen er en ny pasningsordning, er der i øjeblikket ledige pladser.

				Frem til foråret 2026 kan børn i alderen 2 år også indskrives.
				<div>
					<p>
						Der afholdes nisseløb hos Stjerneduggen d. 14. december. Læs mere her: 
						<a href="https://www.facebook.com/events/1557667308751518?active_tab=about" target="_blank">Nisseløb hos Stjerneduggen</a>
					</p>
				</div>
			</p>
		</div>
		<div class="eye-catcher-card float-img">
			<div class="fb-wrapper">
				<div class="fb-page" data-href="https://www.facebook.com/profile.php?id=61581368680952" data-tabs="timeline" data-width="" data-height="" data-small-header="false" data-adapt-container-width="true" data-hide-cover="false" data-show-facepile="true"><blockquote cite="https://www.facebook.com/profile.php?id=61581368680952" class="fb-xfbml-parse-ignore"><a href="https://www.facebook.com/profile.php?id=61581368680952">Stjerneduggen</a></blockquote></div>
			</div>
		</div>
	</div>

	<h3>Om mig</h3>
	<div class="text-image-wrap">
		<img src="@ServerContentResolver.GetImageUrl("MeInTree")" alt="Description" class="float-img">
		<p>@aboutMeP1
			<a href="https://www.motorikognatur.dk/">Motorik og Natur</a>
		</p>
		<p>@aboutMeP2</p>
	</div>

	<div class="eye-catcher-card">
		<h2 class="eye-catcher-title2">Mellem klokkeslæt og kruseduller</h2>
		<p class="eye-catcher-subtitle">@poem</p>
	</div>

	<div class="eye-catcher-card">
		<h2 class="eye-catcher-title2">Om navnet Stjerneduggen</h2>
		<p class="eye-catcher-subtitle">@aboutNamingSd</p>
	</div>

</div>


